NOUS_API_KEY=
PANGRAM_API_KEY=
REDUCTO_API_KEY=
# Backup AI if Hermes is unavailable or slow (recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
# auto = pick the best live Hermes model automatically
HERMES_INTERVIEW_MODEL=auto
HERMES_PLAN_MODEL=auto

DEMO_MODE=0
DEMO_DELAY=1.0
QUESTION_TIMEOUT=25
PLAN_TIMEOUT=55

# Claude backup model (used live during the hackathon demo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_VERSION=2026-10-21
# Optional: point the OpenAI-compatible backup at another host
OPENAI_BASE_URL=

# Server hardening
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_5MIN=90
# Set to 0 to stop saving runs to backend/runs/
LOG_RUNS=1
